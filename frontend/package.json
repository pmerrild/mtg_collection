{
  "name": "mtg-vault",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "test:cloudflare": "node --experimental-strip-types --test ../cloudflare/*.test.mjs",
    "cloudflare:dev": "wrangler dev --config ../wrangler.jsonc",
    "cloudflare:deploy": "npm run build && wrangler deploy --config ../wrangler.jsonc"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "typescript": "^5.9.0",
    "vite": "^7.2.0",
    "wrangler": "^4.0.0"
  },
  "engines": {
    "node": ">=22"
  }
}
